rules_version = '2';

// Fan chat for 安崎 Universe.
// Anyone can read. Signed-in visitors (anonymous auth) can post short messages,
// at most one every 3 seconds. Nobody can edit or delete from the site;
// moderators delete messages in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{room}/messages/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'text', 'uid', 'at', 'song'])
        && request.resource.data.keys().hasAll(['name', 'text', 'uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && (!('song' in request.resource.data)
            || (request.resource.data.song is string && request.resource.data.song.size() <= 80))
        && request.resource.data.at == request.time
        && getAfter(/databases/$(database)/documents/posters/$(request.auth.uid)).data.at == request.time
        && (!exists(/databases/$(database)/documents/posters/$(request.auth.uid))
            || get(/databases/$(database)/documents/posters/$(request.auth.uid)).data.at
               < request.time - duration.value(3, 's'));
      allow update, delete: if false;
    }

    // last post time per visitor, used for the 3-second limit above
    match /posters/{uid} {
      allow read: if false;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
    }

    // Live links: only people listed in /hosts can add them (Douyin, TikTok, Weibo, Bilibili and
    // YouTube links, at most one a minute). The sharer or any host can remove one.
    match /rooms/{room}/lives/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/hosts/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['name', 'title', 'url', 'uid', 'at'])
        && request.resource.data.keys().hasAll(['name', 'title', 'url', 'uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 300
        && request.resource.data.url.matches('https://([a-z0-9-]+[.])*(douyin[.]com|iesdouyin[.]com|tiktok[.]com|weibo[.]com|weibo[.]cn|bilibili[.]com|b23[.]tv|youtube[.]com|youtu[.]be)/[^ "<>]*')
        && request.resource.data.at == request.time
        && getAfter(/databases/$(database)/documents/sharers/$(request.auth.uid)).data.at == request.time
        && (!exists(/databases/$(database)/documents/sharers/$(request.auth.uid))
            || get(/databases/$(database)/documents/sharers/$(request.auth.uid)).data.at
               < request.time - duration.value(60, 's'));
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || exists(/databases/$(database)/documents/hosts/$(request.auth.uid)));
      allow update: if false;
    }

    // People allowed to share lives and their screen. The site manager adds a document here in the console,
    // named with the code the person sees on the Live tab. A visitor can only check their own.
    match /hosts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Screen shares: one document per sharer, refreshed every minute while sharing.
    match /rooms/{room}/screens/{host} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == host
        && exists(/databases/$(database)/documents/hosts/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['name', 'title', 'uid', 'sid', 'on', 'at'])
        && request.resource.data.keys().hasAll(['name', 'title', 'uid', 'sid', 'on', 'at'])
        && request.resource.data.uid == host
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.sid is string
        && request.resource.data.sid.size() <= 40
        && request.resource.data.on is bool
        && request.resource.data.at == request.time;
      allow delete: if request.auth != null && request.auth.uid == host;

      // Connection details between the sharer and one viewer. The viewer asks (sid, at) and
      // writes the answer; the sharer writes the offer, or full when there's no room left.
      match /peers/{viewer} {
        function asks() {
          return request.resource.data.keys().hasOnly(['sid', 'at'])
            && request.resource.data.keys().hasAll(['sid', 'at'])
            && request.resource.data.sid is string
            && request.resource.data.sid.size() <= 40
            && request.resource.data.at == request.time;
        }
        allow read: if request.auth != null
          && (request.auth.uid == viewer || request.auth.uid == host);
        allow create: if request.auth != null && request.auth.uid == viewer && asks();
        allow update: if request.auth != null && (
          (request.auth.uid == viewer
            && (asks()
                || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer'])
                    && request.resource.data.answer is string
                    && request.resource.data.answer.size() <= 20000)))
          || (request.auth.uid == host
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offer', 'full'])
            && (!('offer' in request.resource.data)
                || (request.resource.data.offer is string && request.resource.data.offer.size() <= 20000))
            && (!('full' in request.resource.data) || request.resource.data.full is bool)));
        allow delete: if request.auth != null
          && (request.auth.uid == viewer || request.auth.uid == host);
      }
    }

    // last share time per visitor, used for the one-minute limit above
    match /sharers/{uid} {
      allow read: if false;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
    }
  }
}
