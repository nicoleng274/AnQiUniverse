rules_version = '2';

// Fan chat for 安崎 Universe.
// Anyone can read. Signed-in visitors (anonymous auth) can post short messages,
// at most one every 3 seconds. Nobody can edit or delete from the site;
// moderators delete messages in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{room}/messages/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'text', 'uid', 'at', 'song'])
        && request.resource.data.keys().hasAll(['name', 'text', 'uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && (!('song' in request.resource.data)
            || (request.resource.data.song is string && request.resource.data.song.size() <= 80))
        && request.resource.data.at == request.time
        && getAfter(/databases/$(database)/documents/posters/$(request.auth.uid)).data.at == request.time
        && (!exists(/databases/$(database)/documents/posters/$(request.auth.uid))
            || get(/databases/$(database)/documents/posters/$(request.auth.uid)).data.at
               < request.time - duration.value(3, 's'));
      allow update, delete: if false;
    }

    // last post time per visitor, used for the 3-second limit above
    match /posters/{uid} {
      allow read: if false;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
    }

    // Live links fans share from events: only Douyin, TikTok, Weibo, Bilibili and YouTube links,
    // at most one a minute per visitor. The person who shared a live can remove it.
    match /rooms/{room}/lives/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'title', 'url', 'uid', 'at'])
        && request.resource.data.keys().hasAll(['name', 'title', 'url', 'uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 300
        && request.resource.data.url.matches('https://([a-z0-9-]+[.])*(douyin[.]com|iesdouyin[.]com|tiktok[.]com|weibo[.]com|weibo[.]cn|bilibili[.]com|b23[.]tv|youtube[.]com|youtu[.]be)/[^ "<>]*')
        && request.resource.data.at == request.time
        && getAfter(/databases/$(database)/documents/sharers/$(request.auth.uid)).data.at == request.time
        && (!exists(/databases/$(database)/documents/sharers/$(request.auth.uid))
            || get(/databases/$(database)/documents/sharers/$(request.auth.uid)).data.at
               < request.time - duration.value(60, 's'));
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // last share time per visitor, used for the one-minute limit above
    match /sharers/{uid} {
      allow read: if false;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
    }
  }
}
